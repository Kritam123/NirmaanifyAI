FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat curl
RUN npm install -g pnpm@11.21.0 turbo

WORKDIR /app

# Prevent Prisma from running generate prematurely during pnpm install
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=1

# Copy repository source files (filtered by .dockerignore)
COPY . .

# Install workspace dependencies (using --no-frozen-lockfile for cross-platform compatibility)
RUN pnpm install --no-frozen-lockfile

# Generate Prisma client for shared database package
RUN pnpm --filter @nirmaanify/database generate

# Build internal shared dependencies
RUN pnpm --filter @nirmaanify/types build
RUN pnpm --filter @nirmaanify/database build
RUN pnpm --filter @nirmaanify/api-client build

# Build arguments for Next.js public variables
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-/api/v1}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV PORT=3000

# Build Next.js application
RUN pnpm --filter web build

EXPOSE 3000

CMD ["pnpm", "--filter", "web", "start"]
