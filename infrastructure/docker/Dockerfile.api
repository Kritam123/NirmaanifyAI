FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl curl netcat-openbsd
RUN npm install -g pnpm@11.21.0 turbo

WORKDIR /app

# Copy root workspace configurations
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy all package manifests for optimal layer caching
COPY packages/config/package.json ./packages/config/
COPY packages/types/package.json ./packages/types/
COPY packages/database/package.json ./packages/database/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY packages/icons/package.json ./packages/icons/
COPY packages/ui/package.json ./packages/ui/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/plugin-sdk/package.json ./packages/plugin-sdk/
COPY packages/sandbox-driver/package.json ./packages/sandbox-driver/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/worker/package.json ./apps/worker/

# Install workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy Prisma schema and generate Prisma client
COPY packages/database/prisma ./packages/database/prisma
RUN pnpm --filter @nirmaanify/database generate

# Copy package source codes
COPY packages/ ./packages/

# Copy API application source code
COPY apps/api/ ./apps/api/

# Build internal shared packages and API application
RUN pnpm --filter @nirmaanify/types build
RUN pnpm --filter @nirmaanify/database build
RUN pnpm --filter @nirmaanify/plugin-sdk build
RUN pnpm --filter @nirmaanify/sandbox-driver build
RUN pnpm --filter api build

# Copy entrypoint script
COPY infrastructure/docker/entrypoint-api.sh /usr/local/bin/entrypoint-api.sh
RUN chmod +x /usr/local/bin/entrypoint-api.sh

EXPOSE 4000

ENV NODE_ENV=production
ENV PORT=4000

ENTRYPOINT ["/usr/local/bin/entrypoint-api.sh"]
CMD ["pnpm", "--filter", "api", "start"]
