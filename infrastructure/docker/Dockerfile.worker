FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl curl
RUN npm install -g pnpm@11.21.0 turbo

WORKDIR /app

# Prevent Prisma from running generate prematurely during pnpm install
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=1
ENV NODE_OPTIONS="--max-old-space-size=1024"

# Copy workspace definitions
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./

# Copy internal packages and only the worker application (apps/web is excluded!)
COPY packages ./packages
COPY apps/worker ./apps/worker

# Install workspace dependencies for worker and its dependencies only (skips Next.js optional SWC binaries)
RUN pnpm --filter worker... install --no-frozen-lockfile --no-optional && pnpm store prune

# Generate Prisma client
RUN pnpm --filter @nirmaanify/database generate

# Build internal packages and worker
RUN pnpm --filter @nirmaanify/types build
RUN pnpm --filter @nirmaanify/database build
RUN pnpm --filter worker build

ENV NODE_ENV=production

CMD ["pnpm", "--filter", "worker", "start"]
