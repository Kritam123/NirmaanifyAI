FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl curl
RUN npm install -g pnpm@11.21.0 turbo

WORKDIR /app

# Prevent Prisma from running generate prematurely during pnpm install
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=1
ENV NODE_OPTIONS="--max-old-space-size=1024"

# 1. Copy workspace manifests first to maximize Docker layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/database/package.json ./packages/database/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/icons/package.json ./packages/icons/
COPY packages/design-tokens/package.json ./packages/design-tokens/
COPY packages/api-client/package.json ./packages/api-client/
COPY apps/worker/package.json ./apps/worker/

# 2. Install workspace dependencies using BuildKit persistent cache mount
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm --filter worker... install --no-frozen-lockfile --no-optional

# 3. Copy Prisma schema and generate client
COPY packages/database/prisma ./packages/database/prisma/
RUN pnpm --filter @nirmaanify/database generate

# 4. Copy actual source code (only invalidates from here down when source code changes!)
COPY packages ./packages
COPY apps/worker ./apps/worker

# 5. Build internal packages and worker
RUN pnpm --filter @nirmaanify/types build
RUN pnpm --filter @nirmaanify/database build
RUN pnpm --filter worker build

ENV NODE_ENV=production

# Setup entrypoint script
COPY infrastructure/docker/entrypoint-worker.sh /usr/local/bin/entrypoint-worker.sh
RUN chmod +x /usr/local/bin/entrypoint-worker.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-worker.sh"]
CMD ["pnpm", "--filter", "worker", "start"]
