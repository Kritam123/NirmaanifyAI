# ==============================================================================
# NIRMAANIFY AI — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env on your DigitalOcean VPS:
#   cp .env.production.example .env
#   chmod 600 .env
#
# Generate secure 32+ character secrets using:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
WEB_PORT=3000

# Your droplet's public domain name or IP address (without trailing slash)
# Example: https://nirmaanify.yourdomain.com
APP_DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=nirmaanify_admin
# Generate a strong password (e.g. openssl rand -base64 24 | tr -dc 'a-zA-Z0-9')
POSTGRES_PASSWORD=replace_with_strong_db_password_32chars
POSTGRES_DB=nirmaanify_prod

# Full connection string for Prisma & NestJS (internal Docker network host is postgres)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & BULLMQ QUEUE
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Leave blank or set a strong password
REDIS_PASSWORD=replace_with_strong_redis_password_32chars

# ------------------------------------------------------------------------------
# 4. BACKEND AUTHENTICATION (NestJS JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_jwt_secret_hex_32_characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. FRONTEND AUTHENTICATION (NextAuth / Auth.js v5)
# ------------------------------------------------------------------------------
# Set to your live production URL: https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com
AUTH_URL=https://yourdomain.com/api/auth

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace_with_random_auth_secret_hex_32_characters
AUTH_SECRET=replace_with_random_auth_secret_hex_32_characters
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# 6. OAUTH PROVIDERS (Optional - leave empty if not used)
# ------------------------------------------------------------------------------
# GitHub OAuth: https://github.com/settings/developers
# Authorization Callback URL: https://yourdomain.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. OBJECT STORAGE ENGINE (MinIO / DigitalOcean Spaces / AWS S3)
# ------------------------------------------------------------------------------
# Options: "local" or "s3"
STORAGE_DRIVER=s3

# Built-in MinIO container credentials
MINIO_ROOT_USER=minio_admin_user
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password_32chars

# If using built-in MinIO container:
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET_NAME=nirmaanify-storage

# If using DigitalOcean Spaces instead of MinIO container:
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_REGION=nyc3
# S3_ACCESS_KEY=your_do_spaces_key
# S3_SECRET_KEY=your_do_spaces_secret
# S3_BUCKET_NAME=your_space_bucket

# ------------------------------------------------------------------------------
# 8. AI ENGINE & SANDBOX INTEGRATIONS
# ------------------------------------------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=

# Anthropic Claude API Key (optional)
ANTHROPIC_API_KEY=

# E2B Sandbox API Key for executing isolated code
E2B_API_KEY=
