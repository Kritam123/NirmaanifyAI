# Nirmaanify AI — Environment Configuration Template
NODE_ENV=development
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nirmaanify?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root

# Backend JWT Authentication (NestJS API)
JWT_SECRET=super_secret_nirmaanify_jwt_key_32chars_long!
JWT_EXPIRES_IN=7d

# NextAuth (Auth.js v5) Core Configuration
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000/api/auth
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
AUTH_SECRET=generate_with_openssl_rand_hex_32
AUTH_TRUST_HOST=true

# NextAuth GitHub OAuth Provider
# 1. Register App at: https://github.com/settings/developers
# 2. Set Authorization Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# NextAuth Google OAuth Provider
# 1. Register App at: https://console.cloud.google.com/apis/credentials
# 2. Set Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Multi-Driver Storage Engine
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9001
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=nirmaanify.ai
BLOB_READ_WRITE_TOKEN=
