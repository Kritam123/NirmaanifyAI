# Nirmaanify AI — Environment Configuration

# App
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nirmaanify?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_nirmaanify_jwt_key_32chars_long!
JWT_EXPIRES_IN=7d

# S3 / MinIO Storage
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=nirmaanify-storage
